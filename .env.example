# 复制为 .env 或注入 Portainer Stack 环境变量（勿提交真实密码）
# SMTP 与 john-ip-studio / john-english-study 对齐

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=yulei_han@163.com
SMTP_PASSWORD=
SMTP_FROM=yulei_han@163.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# 生产请清空，启用随机验证码
AUTH_FIXED_CODE=

# HS256 至少 32 字节；过短会导致登录在验证码通过后失败（表象常为「验证码已过期」）
JWT_SECRET=john-ecommerce-prod-jwt-secret-change-me-32b+
